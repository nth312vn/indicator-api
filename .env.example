# App Settings
APP_NAME="Technical Indicator API"
APP_VERSION="1.0.0"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Fiin Data Upstream API Configuration
FIIN_DATA_API_BASE_URL="http://127.0.0.1:8000"
FIIN_DATA_API_PATH="/api/v1/portfolio-construction/fiin_data/stockist"
FIIN_API_TIMEOUT_SECONDS=30.0
FIIN_MAX_KEEPALIVE_CONNECTIONS=20
FIIN_MAX_CONNECTIONS=100
FIIN_FETCH_PAGE_SIZE=1000

# Fallback to internal realistic mock OHLCV generator if upstream is unreachable
ENABLE_MOCK_FALLBACK=True

# Thread pool max workers for parallel indicator calculations (None = auto based on CPU)
MAX_WORKERS=
